<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.44" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.44/schema/PACK.xsd">
  <name>Acme_DFP</name>
  <vendor>Acme</vendor>
  <description>Acme AC1 device family pack (test fixture)</description>
  <url>https://example.com/packs/</url>
  <releases>
    <release version="0.9.0" date="2026-09-01">First release.</release>
  </releases>
  <devices>
    <family Dfamily="AC1 Series" Dvendor="Acme:999">
      <processor Dcore="Cortex-M33" DcoreVersion="r0p4" Dfpu="SP_FPU" Dmpu="MPU" Dtz="TZ" Ddsp="DSP" Dendian="Little-endian" Dclock="160000000"/>
      <subFamily DsubFamily="AC12">
        <device Dname="AC12_xA"/>
        <device Dname="AC12_xOLD"/>
      </subFamily>
      <device Dname="AC2_xA">
        <processor Dcore="Cortex-M55" Dfpu="DP_FPU" Dmpu="MPU" Dtz="TZ" Ddsp="DSP" Dendian="Little-endian" Dclock="400000000"/>
        <variant Dvariant="AC2_xA_LP"/>
      </device>
    </family>
  </devices>
  <components>
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0">
      <description>Startup</description>
      <files><file category="sourceC" name="startup.c"/></files>
    </component>
  </components>
</package>
